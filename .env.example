# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: NUNCA exponer al cliente. Solo se usa en Server Actions/
# Route Handlers de confianza (webhook de Stripe, generación de certificados).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Comisión de la plataforma sobre cada venta (porcentaje)
PLATFORM_FEE_PERCENT=20

# URL pública del sitio (usada en success_url/cancel_url de Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
